If:
  PathMatch: [".*.c", ".*.h"] # Configuration for dpu binaries

CompileFlags:
  Add: [
    "-I/usr/include/dpu",
    "-ldpu",
    "-std=c11",
    "-x", "c",
    "--target=dpu-upmem-dpurte"
  ]
